On Server

# cat /etc/stunnel/stunnel.conf
cert = /etc/stunnel/server.pem
sslVersion = TLSv1.2
pid = /stunnel.pid
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

[sshd]
accept = 0
connect = 0
TIMEOUTclose = 0


this sslVersion=TLSv1.2 will work for macos client, 
if it's TLSv1, server will show "tls_early_post_process_client_hello: unsupported protol" when client connect on macos

---------------------------------------------------------------

comment ~/.ssh/config
#ServerAliveInterval 120
#ControlPersist 2h
#ControlMaster auto
#ControlPath ~/.ssh/master-%r@%h:%p

disable ControlMaster for remote nologin user, otherwise it will login then disconnect immediatly

when config like

Host moon
    HostName moon
    User root
    PreferredAuthentications publickey
    Port 0
    IdentityFile ~/.ssh/id_rsa

DO NOT CONFIG ControlMaster


or

config ControlMaster, do not config Host moon
