example.key is Private Key, 
example.csr is Certificate Signing Request
example.crt is Certificate
this above command does not generate Root Certificate, aka Root CA, 
the next command can do it
#Create the Root CA Private Key and CSR
openssl req -nodes -newkey rsa:2048 -keyout ca.key -out ca.csr -subj "/C=GB/ST=London/L=London/O=Acme Widgets/OU=IT Department/CN=Acme Root CA"

#Create the Root CA Certificate
openssl x509 -req -days 3650 -in ca.csr -signkey ca.key -out ca.crt -extensions v3_ca -extfile <(echo -e "[v3_ca]\nbasicConstraints=critical,CA:TRUE\nkeyUsage=critical,keyCertSign,cRLSign")

#Verify the Root CA Certificate:
openssl x509 -in ca.crt -noout -text
look for
X509v3 Basic Constraints: critical
    CA:TRUE
X509v3 Key Usage: critical
    Certificate Sign, CRL Sign

# Generate a Server Certificate Signed by the Root CA
openssl req -nodes -newkey rsa:2048 -keyout server.key -out server.csr -subj "/C=GB/ST=London/L=London/O=Acme Widgets/OU=IT Department/CN=127.0.0.1" -addext "subjectAltName=IP:127.0.0.1"

#Sign the Server CSR with the Root CA
openssl x509 -req -days 365 -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -extfile <(echo -e "[v3_req]\nbasicConstraints=CA:FALSE\nsubjectAltName=IP:127.0.0.1\nkeyUsage=critical,digitalSignature,keyEncipherment")

#Verify the Server Certificate:
openssl x509 -in server.crt -noout -text
look for
Issuer: C=GB, ST=London, L=London, O=Acme Widgets, OU=IT Department, CN=Acme Root CA
Subject: C=GB, Lill=London, O=Acme Widgets, OU=IT Department, CN=127.0.0.1
X509v3 Subject Alternative Name:
    IP Address:127.0.0.1
X509v3 Basic Constraints:
    CA:FALSE

