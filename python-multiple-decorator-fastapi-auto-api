def create_register():
    registered = {}
    def wrapper(func):
        registered[func.__name__] = func
        return func
    return wrapper, registered

register, functions = create_register()

def json_wrapper(func):
    def _para(*args, **kwargs):
        now = datetime.now()
        timestamp = now.isoformat()
        try:
            result = func(*args, **kwargs)
            return {
                "code": 200,
                "msg": "success",
                "data": result,
                "success": True,
                "time": timestamp
            }

        except Exception as e:
            return {
                "code": 500,
                "msg": str(e),
                "success": False,
                "time": timestamp
            }

    return _para

