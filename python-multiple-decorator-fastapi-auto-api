from functools import wraps
import json
def cache_func(f):
    _dict = {}
    @wraps(f)
    def wrapper(*args, **kwargs):
        k = f.__name__ + json.dumps({"args": args, "kwargs": kwargs})
        if k in _dict:
            return _dict[k]
        else:
            result = f(*args, **kwargs)
            _dict[k] = result
            return result
    return wrapper


# cache fib(n), fib(6) will use fib(5) cache
@cache_func
def fib(n):
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)
        
for i in range(1,9000):
    print(fib(i))

@cache_func
def test():
    import time
    time.sleep(3)
    return 3

print(test())
print(test()) # this second won't wait for 3s

