    def json_wrapper(func):
        import inspect

        async def _para(*args, **kwargs):
            now = datetime.now()
            timestamp = now.isoformat()
            try:
                result = func(*args, **kwargs)
                if inspect.isawaitable(result):
                    result = await result
                return {
                    "code": 200,
                    "msg": "success",
                    "data": result,
                    "success": True,
                    "time": timestamp
                }

            except Exception as e:
                log.error(str(e))
