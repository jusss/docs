Another way

async def main():
    loop = asyncio.get_running_loop()
    t = await loop.create_datagram_endpoint(RecvLocalThenSend, local_addr=('0.0.0.0', 53)) #inside normal func, use asyncio.get_running_loop().create_task(async_func)
    await asyncio.sleep(3600000)

if __name__ == '__main__':
    asyncio.run(main())


Another way
 
async def main():
  task = asyncio.create_task(another_async_func())
  # await task for other task
  await asyncio.gather(task, another_task)

if __name__ == '__main__':
    asyncio.run(main())


