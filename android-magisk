#!/system/bin/sh

# Wait for boot to complete
while [ "$(getprop sys.boot_completed)" != "1" ]; do
    sleep 2
done

# Give ActivityManager time to start
sleep 10

# ─── Cached process limits ───
# Raises from 32 → 128 (makes actual use of 12GB RAM)
device_config set_sync_disabled_for_tests persistent
device_config put activity_manager max_cached_processes 128
device_config put activity_manager max_phantom_processes 2147483647
settings put global settings_enable_monitor_phantom_procs false

# Keep empty processes alive longer (30 min instead of ~10 min)
device_config put activity_manager max_empty_time_millis 600000

# ─── Relax background CPU throttling ───
# Default is 10 — raises to 25 so background apps don't get "excessive cpu" kills
# device_config put activity_manager bg_cgroup_cpu_limit 25
# resetprop persist.sys.fw.bg_cgroup_cpu_limit 25


# ─── App standby: less aggressive ───
# Extend the time before apps are marked "restricted" (7 days → 30 days)
settings put global app_idle_constants inactive_to_never=2592000000


# Log what we did
echo "[cached_fix] Applied: max_cached=128, empty_time=1800000, cpu_limit=25" >> /data/local/tmp/cached_fix.log

