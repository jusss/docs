#!/system/bin/sh
# Wait for the system boot to complete fully
until [ "$(getprop sys.boot_completed)" = "1" ]; do
    sleep 3
done

# 1. Force lmkd to disable PSI and use the legacy minfree engine
#resetprop ro.lmk.use_psi false
#resetprop ro.lmk.use_minfree_levels true


resetprop ro.lmk.use_psi true
resetprop ro.lmk.use_minfree_levels false
resetprop ro.lmk.low 1001            # Low memory PSI threshold
resetprop ro.lmk.medium 800          # Medium threshold
resetprop ro.lmk.critical 600        # Critical threshold (higher = less killing)
resetprop ro.lmk.critical_upgrade false
resetprop ro.lmk.upgrade_pressure 100
resetprop ro.lmk.kill_timeout_ms 100
resetprop ro.lmk.downgrade_pressure 100
resetprop ro.lmk.swap_free_low_percentage 10
resetprop ro.lmk.psi_partial_stall_ms 200
resetprop ro.lmk.psi_complete_stall_ms 700


## resetprop persist.sys.fw.bg_cgroup_cpu_limit 25
# this would take huge ram in zram
#resetprop ro.sys.fw.bservice_enable true
#resetprop ro.sys.fw.bservice_limit 10
#resetprop ro.sys.fw.bservice_age 60000


# 2. Set highly relaxed minfree values (in pages)
resetprop ro.lmk.minfree_levels "2048:0,4096:100,8192:200,12288:250,16384:900,24576:950"
resetprop sys.lmk.minfree_levels "2048:0,4096:100,8192:200,12288:250,16384:900,24576:950"

# 3. Tell the system to prioritize physical RAM before touching zRAM
echo "200" > /proc/sys/vm/swappiness

# Make the kernel reclaim file/directory caches much more aggressively
# echo "200" > /proc/sys/vm/vfs_cache_pressure
# echo 0 > /proc/sys/vm/compaction_proactiveness
# echo 1000 > /proc/sys/vm/watermark_scale_factor

# Keep dirty file cache footprints low by flushing to disk earlier
#echo "5" > /proc/sys/vm/dirty_background_ratio
#echo "10" > /proc/sys/vm/dirty_ratio


# 4. Disable the Android Phantom Process Killer (No more 32-process limit)
device_config put activity_manager max_phantom_processes 256

# 5. Force lmkd to restart and apply all changes
setprop lmkd.reinit 1


