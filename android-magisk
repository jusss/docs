cat /data/adb/service.d/max_multitasking.sh                                                                                                 
#!/system/bin/sh
# Wait for the system boot to complete fully
until [ "$(getprop sys.boot_completed)" = "1" ]; do
    sleep 3
done

# 1. Force lmkd to disable PSI and use the legacy minfree engine
resetprop ro.lmk.use_psi false
resetprop ro.lmk.use_minfree_levels true

# 2. Set highly relaxed minfree values (in pages)
# Translates to: 
# Only kill empty apps below 96MB of free RAM.
# Only kill foreground apps below 8MB (basically never).
resetprop ro.lmk.minfree_levels "2048:0,4096:100,8192:200,12288:250,16384:900,24576:950"
resetprop sys.lmk.minfree_levels "2048:0,4096:100,8192:200,12288:250,16384:900,24576:950"

# 3. Tell the system to prioritize physical RAM before touching zRAM
echo "30" > /proc/sys/vm/swappiness

# 4. Force lmkd to restart and apply all changes
setprop lmkd.reinit 1


