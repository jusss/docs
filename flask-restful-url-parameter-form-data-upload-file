from flask import request
from flask_login import current_user
from flask_restful import Resource, reqparse
class A:
    def post(self):
        parser = reqparse.RequestParser()
        # flask restful
        # https://flask-restplus.readthedocs.io/en/stable/parsing.html
        # Look only in the POST body, form data, python requests post with 'data' = {}
        parser.add_argument('name', type=int, location='form')

        # Look only in the querystring, url parameters, for python requests post with 'params' = {}
        parser.add_argument('age', type=int, location='args')

        # From the request headers
        parser.add_argument('User-Agent', location='headers')

        # From http cookies
        parser.add_argument('session_id', location='cookies')

        # From file uploads
        parser.add_argument('picture', type=werkzeug.datastructures.FileStorage, location='files')

        # Only use type=list when location='json'

        args = parser.parse_args()
