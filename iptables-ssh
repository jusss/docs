On Server:

iptables-ssh.sh
#!/bin/bash
SSH_PORT=22
ALLOW_IP="1.1.1.1"
systemctl start iptables
systemctl enable iptables
iptables -A INPUT -i lo -p tcp --dport "$SSH_PORT" -j ACCEPT
iptables -A INPUT -s "$ALLOW_IP" -p tcp --dport "$SSH_PORT" -j ACCEPT
iptables -A INPUT -p tcp --dport "$SSH_PORT" -j DROP
iptables-save -f /etc/iptables/iptables.rules

# vim /etc/iptables/iptables.rules, to change some rules and reload
# iptables-restore < /etc/iptables/iptables.rules
# iptables -L

/etc/stunnel/stunnel.conf
cert = /etc/stunnel/server.pem
sslVersion = TLSv1.2
pid = /stunnel.pid
socket = l:TCP_NODELAY=1
socket = r:TCP_NODELAY=1

[sshd]
accept = 22222
connect = 22
TIMEOUTclose = 0

[openvpn]
accept = 20183
connect = 20182

systemctl start stunnel
systemctl enable stunnel


