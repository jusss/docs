1. front-end choose file, and send file path to server
2. on server, get file path, use COS sdk generate signed url to front-end, or use COS sdk to upload file directly
3. front-end use PUT or POST request upload file to tencent cloud

the next code on server is generate signed url for post or download 
# Bucket is bucket name, Key is file path like doc/pic.jpg as unique identifier
# it would be like examplebucket-1250000000.cos.ap-guangzhou.myqcloud.com/doc/pic.jpg for visit

from qcloud_cos import CosConfig
from qcloud_cos import CosS3Client
import sys
import os
import logging
import requests

logging.basicConfig(level=logging.INFO, stream=sys.stdout)

secret_id = os.environ['COS_SECRET_ID']
secret_key = os.environ['COS_SECRET_KEY']
region = 'ap-beijing'
token = None
scheme = 'https'

config = CosConfig(Region=region, SecretId=secret_id, SecretKey=secret_key, Token=token, Scheme=scheme)
client = CosS3Client(config)

url = client.get_presigned_url(
    Method='PUT',
    Bucket='examplebucket-1250000000',
    Key='exampleobject',
    Expired=120
)
print(url)

# upload file by url
retry = 1 
for i in range(retry + 1):
    response = requests.put(url=url, data=b'123')
    if response.status_code == 400 or response.status_code >= 500: 
        time.sleep(1) 
        continue
    print(response)
    break

