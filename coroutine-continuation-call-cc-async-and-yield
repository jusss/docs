from contextvars import ContextVar
import asyncio

request_id = ContextVar("request_id", default="123")
session_id = 123

async def func():
    print("request_id ", request_id.get())
    await func1()
    await func2()

async def func1():
    request_id.set("456")
    session_id= 456
    print("func1 session_id ", session_id)
    print("func1 request id ",request_id.get())

async def func2():
    print("func2 session_id:",session_id)
    print("func2 request_id ",request_id.get())

async def main():
    #tasks = [asyncio.create_task(func1()), asyncio.create_task(func2())]
    tasks = [asyncio.create_task(func())]
    await asyncio.gather(*tasks)

asyncio.run(main())

# 1. parallel functions like tasks = [asyncio.create_task(func1()), asyncio.create_task(func2())]
# the context var and local var session they both send to func1 and func2, since they're parallel, func1 change them,
# won't affect func2's context var and session,
# 2. await will block function, await func1() await func2() will make them not parallel, func2 will block until func1 
# is done, so func1 and func2 share the same context var, but func1 change local var won't affect func2's local var
# 3. there's another way, share one var and jump with it between func1 and func2, use yield, like call/cc 
