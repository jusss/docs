pgvector是postgresql启用了vector扩展之后的向量数据库，dbeaver可以用postgresql的驱动链接pgvector,
向量表里会有一个vector类型的embedding column, 1024维就是一个str list里面存了1024个数字,
可以向量化某个column的值然后存储在embedding column, 然后向量检索embedding column
这个向量维度和embedding模型的维度需要一致，比如用bge-m3 向量化数据然后存储，存储维度需要和bge-m3的维度一样
比如想要向量搜索question，那就把question向量化的数据存储在embedding column, 然后query向量化后和embedding匹配获取question


使用pgvector扩展存储文本向量

启用pgvector扩展（如果未启用）
CREATE EXTENSION IF NOT EXISTS vector;


CREATE TABLE IF NOT EXISTS question_generalization_vectors (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),          -- 使用 gen_random_uuid() 自动生成 UUID
    question TEXT NOT NULL,                                 -- 问题文本，假设为非空
    question_list TEXT[],                                   -- 文本列表，使用 PostgreSQL 数组类型
    embedding VECTOR(1024),  -- 向量（embedding模型输出1024维向量）
    region VARCHAR(255),                                    -- 区域，可指定长度
    create_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 创建时间
    update_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 更新时间
    source VARCHAR(255),                                    -- 来源
    extra JSONB                                             -- 额外的 JSON 数据
);


创建向量索引（使用IVFFlat索引，适合大规模向量检索）
CREATE INDEX IF NOT EXISTS question_generalization_vectors_embedding_idx
ON question_generalization_vectors
USING ivfflat (embedding vector_cosine_ops)
WITH (lists = 100);


向量搜索
pgvector的threshold和ChromaDB有差异
pgvector 你需要先在查询中计算出相似度分数，然后再用WHERE子句进行过滤
ChromaDB 在调用similarity_search_with_relevance_scores等方法时，直接传入score_threshold参数，由数据库自动过滤

-- 假设用户输入的新问题是 "怎样修改密码？"
-- 第一步：在应用程序中调用嵌入模型，将 "怎样修改密码？" 转换为1024维向量
-- 假设得到的向量为 [0.234, -0.567, 0.891, ...] (共1024个数字)

-- 第二步：执行相似度搜索，并过滤出相似度大于0.7的结果
WITH query_vector AS (
    SELECT '[0.234, -0.567, 0.891, ...]'::vector AS vec  -- 替换为实际生成的向量
)
SELECT id, question,
    -- 计算相似度分数 (余弦相似度 = 1 - 余弦距离)，范围 [0, 2]，越接近1越相似
    1 - (embedding <=> (SELECT vec FROM query_vector)) AS similarity_score
FROM 
    question_generalization_vectors
WHERE 
    -- 过滤：仅返回相似度 > 0.7 的记录
    1 - (embedding <=> (SELECT vec FROM query_vector)) > 0.7
ORDER BY 
    embedding <=> (SELECT vec FROM query_vector)  -- 按距离升序（越相似越靠前）
LIMIT 10;  -- 限制返回数量


