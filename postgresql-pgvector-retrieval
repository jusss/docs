-- 插入数据时，先用bge-m3模型将question向量化
INSERT INTO question_generalization_vectors (
    question,
    question_list,
    embedding,  -- 存储bge-m3生成的1024维向量
    region,
    source,
    extra
) VALUES (
    '如何重置密码？',
    ARRAY['密码重置', '忘记密码'],
    '[0.123, -0.456, 0.789, ...]'::vector(1024),  -- bge-m3生成的向量
    'asia',
    'user_manual',
    '{"category": "security"}'::jsonb
);

-- 用户查询："怎样修改密码？"
-- 第一步：用bge-m3将查询文本向量化
-- 第二步：执行相似度搜索

WITH query_vector AS (
    SELECT '[0.234, -0.567, 0.891, ...]'::vector(1024) AS vec  -- bge-m3生成的查询向量
)
SELECT
    id,
    question,
    question_list,
    1 - (embedding <=> qv.vec) AS similarity_score
FROM
    question_generalization_vectors,
    query_vector qv
WHERE
    region = 'asia'  -- 区域过滤
    AND 1 - (embedding <=> qv.vec) >= 0.7  -- 相似度阈值
ORDER BY
    embedding <=> qv.vec  -- 按距离升序排列
LIMIT 10;


-- 如果数据量很大（>100万条），考虑使用HNSW索引
CREATE INDEX IF NOT EXISTS question_generalization_vectors_embedding_hnsw_idx
ON question_generalization_vectors
USING hnsw (embedding vector_cosine_ops)
WITH (m = 16, ef_construction = 200);

-- 或者使用IVFFlat（适合中等规模数据）
CREATE INDEX IF NOT EXISTS question_generalization_vectors_embedding_ivfflat_idx
ON question_generalization_vectors
USING ivfflat (embedding vector_cosine_ops)
WITH (lists = 100);

-- 如果查询频繁，可以创建物化视图预计算热门查询
CREATE MATERIALIZED VIEW hot_question_similarity AS
SELECT
    q1.id AS source_id,
    q2.id AS target_id,
    q1.question AS source_question,
    q2.question AS target_question,
    1 - (q1.embedding <=> q2.embedding) AS similarity
FROM
    question_generalization_vectors q1,
    question_generalization_vectors q2
WHERE
    q1.id != q2.id
    AND 1 - (q1.embedding <=> q2.embedding) > 0.8;

    # Python示例：批量向量化并插入
import psycopg2
from sentence_transformers import SentenceTransformer

model = SentenceTransformer('BAAI/bge-m3')
questions = ["问题1", "问题2", "问题3"]
embeddings = model.encode(questions)

conn = psycopg2.connect("dbname=test user=postgres")
cur = conn.cursor()

# 批量插入
data = [(q, emb.tolist()) for q, emb in zip(questions, embeddings)]
cur.executemany(
    "INSERT INTO question_generalization_vectors (question, embedding) VALUES (%s, %s::vector)",
    data
)
conn.commit()

-- 适用于应用程序调用的参数化查询
SELECT
    question,
    question_list,
    1 - (embedding <=> %(query_vector)s::vector) AS similarity
FROM
    question_generalization_vectors
WHERE
    region = %(region)s
    AND 1 - (embedding <=> %(query_vector)s::vector) >= %(threshold)s::float
ORDER BY
    embedding <=> %(query_vector)s::vector
LIMIT %(limit)s;

注意事项
维度一致性：确保bge-m3模型输出1024维，与表定义VECTOR(1024)一致

相似度范围：余弦相似度范围是[-1, 1]，使用1 - cosine_distance转换为[0, 2]

阈值调优：根据实际数据分布调整阈值，一般0.7-0.9之间效果较好

索引重建：大数据量插入后，需要重建IVFFlat索引以保持性能
