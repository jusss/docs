mapK :: (a -> (b -> r) -> r) -> [a] -> ([b] -> r) -> r
mapK p [] k = k []
mapK p (x:xs) k = p x $ \v -> case v of
    0 -> k [0]  -- Stop processing when 0 is encountered
    _ -> mapK p xs (\ns -> k (v : ns))

