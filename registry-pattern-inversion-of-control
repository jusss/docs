def create_register():
    registered = {}
    def wrapper(func):
        registered[func.__name__] = func
        return func
    return wrapper, registered

register, functions = create_register()

def common(alist):
    result = []
    for i in alist:
        if functions.get(i["function"]):
            result.append({"function": i["function"], "result": functions[i["function"]](**i["parameter"])})
        else:
            result.append({"function":i["function"], "result": f"function {i['function']} is not found"})
    return result

@register
def f(x):
    print(x)
    return x

@register
def g(x):
    print(x+1)

#1 IoC
@app.post("/api/common1")
def f(alist:[dict]):
  # let assume alist is like [{"function":"f", "parameter":{"x":1}}, {"function":"g", "parameter":{"x":1}},{"function":"x", "parameter":{"x":1}}]
  r= common(alist)
  return r

#2 DI,  (lambda **kwargs: f" not found")(1,2)  short-circuit, beautiful, this lambda **kwargs is a continuation, framework call my function in the end, my funciton is continuation

@app.post("/api/common2")
def f(function:str=Body(...), parameter: dict=Body(...), fn=Depends(lambda function: functions.get(function, lambda **kwargs: f"{function} not found"))):
  return fn(**parameter)

#3 DI, framework call my function, it can pass the envrionment to my function, my function can access that 'function' and 'parameter'
def get_fn(function: str):
  return functions.get(function, lambda **kwargs: f"{function} not found")

@app.post("/api/common2")
def f(function:str=Body(...), parameter: dict=Body(...), fn=Depends(get_fn)):
  return fn(**parameter)

