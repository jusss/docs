    async def get_question_list_by_chunks(chunks: list[str], db) -> list[str]:

        from sqlalchemy import func, select, text

        question_list = []

        try:

            for chunk in chunks:

                tsquery = func.plainto_tsquery('simple', chunk)



                stmt = select(ChunkQuestion).where(

                    func.to_tsvector('simple', ChunkQuestion.chunk).op('@@')(tsquery)

                )

                result = await db.execute(stmt)

                records = result.scalars().all()

                for record in records:

                    question_list.append(record.question_list)



            return reduce(add, question_list)

