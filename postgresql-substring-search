CREATE TABLE IF NOT EXISTS chunk_question (

    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),          -- 使用 gen_random_uuid() 自动生成 UUID

    doc_name VARCHAR(255) NOT NULL,

    chunk TEXT NOT NULL,                                 -- 切片文本，假设为非空

    question_list TEXT[],                                   -- 文本列表，使用 PostgreSQL 数组类型

    create_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 创建时间

    update_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,  -- 更新时间

    extra JSONB                                             -- 额外的 JSON 数据

);



-- 1. doc_name 单列索引（用于按文档过滤）

CREATE INDEX idx_chunk_question_doc_name ON chunk_question(doc_name);



-- 2. doc_name + chunk 复合索引（用于精确查询切片）

CREATE INDEX idx_chunk_question_doc_chunk ON chunk_question(doc_name, chunk);



-- 3. chunk 全文搜索索引（用于内容搜索）, 如果是中文，则按字分割

CREATE INDEX idx_chunk_question_chunk_fts ON chunk_question 

USING GIN (to_tsvector('simple', chunk));



-- 4. 已有的 question_list GIN 索引（保持不变）

CREATE INDEX idx_chunk_question_question_list ON chunk_question 

USING GIN (question_list);



