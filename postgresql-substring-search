pg_vector is an extension on pgsql, pg_vector can with regular pg table in one database

if the data and vectorized data in one pg_vector table, so substring match pg_trgm and vector search can on one table

同一张表上同时建 pg_trgm 的 GIN 索引和 pgvector 的 HNSW 索引，互不冲突，查询时按条件各取所需。

CREATE EXTENSION IF NOT EXISTS vector;

CREATE EXTENSION IF NOT EXISTS pg_trgm;



CREATE TABLE chunk_question (

    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    doc_name VARCHAR(255) NOT NULL,

    chunk TEXT NOT NULL,

    question_list TEXT[],

    extra JSONB,

    embedding vector(384),

    create_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    update_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP

);



-- 普通 B-tree

CREATE INDEX idx_doc_name ON chunk_question(doc_name);



-- 子串匹配（ILIKE '%...%'）

CREATE INDEX idx_chunk_trgm ON chunk_question

    USING GIN (chunk gin_trgm_ops);



-- 全文检索

CREATE INDEX idx_chunk_fts ON chunk_question

    USING GIN (to_tsvector('simple', chunk));



-- 向量检索

CREATE INDEX idx_chunk_vector ON chunk_question

    USING hnsw (embedding vector_cosine_ops);



PostgreSQL 一个查询通常只用一个索引来驱动扫描

如果想要真正的混合检索（全文 top-k + 向量 top-k 再融合），需要写成两个子查询用 CTE 或 UNION，各自用自己的索引：

WITH text_hits AS (

    SELECT id, chunk,

           ts_rank(to_tsvector('simple', chunk),

                   plainto_tsquery('simple', :q)) AS text_score

    FROM chunk_question

    WHERE to_tsvector('simple', chunk) @@ plainto_tsquery('simple', :q)

    ORDER BY text_score DESC

    LIMIT 20

),

vec_hits AS (

    SELECT id, chunk,

           1 - (embedding <=> :query_vec) AS vec_score

    FROM chunk_question

    ORDER BY embedding <=> :query_vec

    LIMIT 20

)

SELECT COALESCE(t.id, v.id) AS id,

       COALESCE(t.chunk, v.chunk) AS chunk,

       t.text_score,

       v.vec_score

FROM text_hits t

FULL OUTER JOIN vec_hits v USING (id);



