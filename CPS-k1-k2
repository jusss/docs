def add_cps(a, b, cont):
    sum = a + b
    cont(sum)

def mul_cps(x, y, cont):
    product = x * y
    cont(product)  

# add → mul → print
add_cps(2, 3, lambda sum: 
    mul_cps(sum, 4, lambda product: 
        print(f"{product}") 
    )
)

def k1(sum):
    mul_cps(sum, 4, id)

add_cps(1,2,k1)

