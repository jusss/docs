
params is for URL Query parameters in GET request
data is for Form Data in POST request, Content-Type: application/x-www-form-urlencoded
json is for JSON Data in POST request, Content-Type: application/json


import requests
url = "https://api.example.com/search"
params = {'q': 'python', 'page': 2}
response = requests.get(url, params=params)
print(response.url)  # Output: "https://api.example.com/search?q=python&page=2"


import requests
url = "https://example.com/login"
data = {'username': '', 'password': ''}
response = requests.post(url, data=data)
print(response.text)


import requests
url = "https://api.example.com/create"
json_data = {'name': '', 'age': }
response = requests.post(url, json=json_data, headers={"Content-Type": "application/json"})
print(response.json())


