import json
from datetime import datetime

class SummaryCompressor:
    def __init__(self, summary_file="context_summary.md"):
        self.summary_file = summary_file
        self.summary = ""

    def compress(self, messages, llm_client):
        # 检测是否超过token上限
        total_tokens = sum(self.count_tokens(m['content']) for m in messages)
        if total_tokens < 8000:  # 假设上限8000
            return messages, None

        # 分离新旧对话
        old_context, recent_context = self.split_context(messages)

        # 生成摘要
        if old_context:
            self.summary = self.generate_summary(old_context, llm_client)
            self.save_summary()

            # 更新system prompt
            system_msg = self.build_system_prompt()
            return [system_msg] + recent_context, self.summary

        return messages, None

    def generate_summary(self, old_context, llm_client):
        prompt = f"""请总结以下对话的关键信息，包括：
1. 用户的主要需求和问题
2. 已经做出的决策和结论
3. 重要的上下文信息
4. 未完成的任务

对话内容：
{json.dumps(old_context, ensure_ascii=False)}
"""
        response = llm_client.chat(prompt)
        return response

    def save_summary(self):
        with open(self.summary_file, 'w', encoding='utf-8') as f:
            f.write(f"# 对话摘要 - {datetime.now()}\n\n")
            f.write(self.summary)
            f.write("\n\n## 检索关键词\n")
            # 提取关键词便于检索
            keywords = self.extract_keywords(self.summary)
            f.write(", ".join(keywords))

    def build_system_prompt(self):
        return {
            "role": "system",
            "content": f"""你是AI助手。以下是历史对话摘要，请在此基础上继续对话：

{self.summary}

注意：
1. 参考摘要中的历史信息
2. 如需要详细历史，请在 {self.summary_file} 中搜索关键词
3. 保持对话连贯性"""
