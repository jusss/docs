class AggressiveCompressor:
    def compress(self, messages):
        # 策略3a: 过滤tool calls
        filtered = []
        for msg in messages:
            # 只保留user和assistant
            if msg['role'] in ['user', 'assistant']:
                # 移除tool_call相关字段
                clean_msg = {
                    'role': msg['role'],
                    'content': msg.get('content', '')
                }
                filtered.append(clean_msg)

        # 策略3b: 更激进 - 只保留user消息
        user_only = [msg for msg in filtered if msg['role'] == 'user']

        return {
            'user_assistant': filtered,
            'user_only': user_only
        }



class HybridCompressor:
    def __init__(self, max_tokens=8000):
        self.max_tokens = max_tokens
        self.sliding = SlidingWindowCompressor(max_tokens)
        self.summary = SummaryCompressor()
        self.aggressive = AggressiveCompressor()

    def compress(self, messages, llm_client):
        # 1. 先尝试滑动窗口
        windowed = self.sliding.compress(messages)

        # 2. 如果还是超限，生成摘要
        if self.count_tokens(windowed) > self.max_tokens:
            compressed, summary = self.summary.compress(messages, llm_client)
            if summary:
                return compressed, "summary_mode"

        # 3. 极端情况：激进过滤
        if self.count_tokens(windowed) > self.max_tokens:
            aggressive = self.aggressive.compress(messages)
            return aggressive['user_assistant'], "aggressive_mode"

        return windowed, "sliding_mode"


# 初始化
compressor = HybridCompressor(max_tokens=8000)

