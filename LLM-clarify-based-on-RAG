CLARIFY_PROMPT = """You are a clarification gate for a RAG assistant.

Decide if the user's CURRENT query is clear enough to answer, given the prior
conversation and retrieved chunks.

Rules:
- If the immediately preceding assistant turn was a clarify question, treat the
  user's reply as resolving it. Only clarify again if a NEW, distinct ambiguity
  appears. Do not clarify the same ambiguity twice.
- Clarify if: the query references an entity/scope not present in context or
  chunks; contains a typo/unknown term that chunks can disambiguate; or is
  underspecified (missing file, version, time range, etc.).
- If clear, output exactly: <CLEAR>
- If not clear, output 1-3 short questions, grounded in the chunks, offering
  concrete options where possible. No preamble.

## Prior conversation
{context}

## Retrieved chunks
{rag}
"""

MAX_CONSECUTIVE_CLARIFY = 2

def clarify_question(old_conversation, rag, query, consecutive_clarify_turns=0):
    # Hard cap: never clarify more than N times in a row
    if consecutive_clarify_turns >= MAX_CONSECUTIVE_CLARIFY:
        return None
    try:
        resp = llm.invoke([
            SystemMessage(content=CLARIFY_PROMPT.format(context=old_conversation, rag=rag)),
            HumanMessage(content=f"Current query: {query}"),
        ]).content.strip()
        if resp.startswith("<CLEAR>") or not resp:
            return None
        return resp
    except Exception:
        return None  # fail open

