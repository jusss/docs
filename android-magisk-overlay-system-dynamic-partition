
magisk overlay on system dynamic partitions since android 10
make zram size right!

for overlay just one file

$ su
# cd /data/adb/modules
# mkdir -p update_zram/system/system_ext/etc
# cp /system/system_ext/etc/perfinit_bdsize_zram.conf update_zram/system/system_ext/etc
# vi update_zram/system/system_ext/etc/perfinit_bdsize_zram.conf

change that "4.0":6144 to 4096
            "auto_zram_ram_8G":{
                "def_bdsize":4.0, "4.0":6144, "6.0":6144, "8.0":8192
            },
# reboot

for reset system prop
/data/adb/modules/update_zram/system.prop
ro.lmk.swap_free_low_percentage=10
ro.lmk.use_psi=true
ro.lmk.use_minfree_levels=false
